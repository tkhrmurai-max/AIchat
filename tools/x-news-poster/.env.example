# --- X (旧Twitter) API: OAuth 1.0a ユーザーコンテキスト ---
# X Developer Portal → 該当アプリ → "Keys and tokens" で発行する。
# ブラウザの認可画面（「アプリにアクセスを許可できません」が出る画面）を通らないため、
# OAuth 2.0 の認可フローで詰まっている場合はこちらを使う。
# 前提: アプリが Project に紐づいていること / App permissions が "Read and write" であること。
#      権限を後から変更した場合は Access Token を再生成すること。
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- 代替: OAuth 2.0 のユーザーアクセストークンを既に持っている場合のみ ---
# 設定するとこちらが優先される（tweet.write スコープが必要）。
# X_OAUTH2_ACCESS_TOKEN=

# --- 下書き生成に使う Gemini ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-pro-preview

# --- 任意: 下書き・投稿履歴の保存先を変更する ---
# X_NEWS_POSTER_DATA_DIR=/path/to/data
